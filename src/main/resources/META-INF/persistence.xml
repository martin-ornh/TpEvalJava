<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="petstore-pu" transaction-type="RESOURCE_LOCAL">

        <class>fr.epsi.petstore.entity.PetStore</class>
        <class>fr.epsi.petstore.entity.Address</class>
        <class>fr.epsi.petstore.entity.Product</class>
        <class>fr.epsi.petstore.entity.Animal</class>
        <class>fr.epsi.petstore.entity.Fish</class>
        <class>fr.epsi.petstore.entity.Cat</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/petstore"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="martin-dev"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>

</persistence>